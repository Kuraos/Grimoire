# Python
backend/.venv/
__pycache__/
*.pyc
backend/grimoire.db
backend/.pytest_cache/
backend/build/
backend/dist/
backend/*.spec

# Node
node_modules/
frontend/node_modules/
frontend/dist/

# Tauri / Rust
src-tauri/target/
src-tauri/gen/

# Build artifacts / logs
*.log

# Editor / OS
.vscode/
.DS_Store

# Claves de firma del updater. Viven en ~/.tauri/, nunca en el repo; esto es
# una red de seguridad por si alguna vez se copian aquí por error.
*.key
!**/*.key.pub

# Respaldos locales de la base
backend/backups/

# Sidecar compilado: se regenera con `npm run sidecar` desde backend/*.py
src-tauri/binaries/

# Salida de las maquetas: `.dc.html` sale de `build.mjs` y el canvas sembrado
# lleva dentro el editor entero (2 MB). La fuente es `parts/` + `_prelude.txt`.
.design-entrenamiento/*.dc.html
.design-entrenamiento/entrenamiento-grimoire.html
