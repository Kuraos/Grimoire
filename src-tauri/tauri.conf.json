{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Grimoire",
  "version": "0.4.0",
  "identifier": "com.grimoire.desktop",
  "build": {
    "frontendDist": "../frontend/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm --prefix frontend run dev",
    "beforeBuildCommand": "npm --prefix frontend run build"
  },
  "app": {
    "windows": [
      {
        "title": "Grimoire",
        "width": 1280,
        "height": 832,
        "minWidth": 980,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/grimoire-backend"],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE3MDZBQkM1QURGRjBGRgpSV1QvOE45YXZHcHdBVC9DT3RDeTlabDJTVVF6L0dIa1NQOGNFZ0pSY282S1htTHV3Qkh2T3Awawo=",
      "endpoints": [
        "https://github.com/Kuraos/Grimoire/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
